# Optional LLM-assisted fact extraction. The application works without an API key.
OPENAI_API_KEY=
REGNAV_MODEL=gpt-5-mini
REGNAV_USE_LLM=false
REGNAV_PROJECT_ROOT=

# Optional additional JSONL corpus produced by the ingestion CLI.
REGNAV_CORPUS_PATH=
REGNAV_CHROMA_DIR=.cache/chroma
REGNAV_TOP_K=8

# Declared service targets used by evaluation and release review.
REGNAV_FAITHFULNESS_TARGET=0.95
REGNAV_P95_LATENCY_TARGET_SECONDS=5

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=regulation-navigator
